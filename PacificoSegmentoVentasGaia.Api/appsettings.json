{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "AppConnection": ""
  },
  "SegmentoVenta": {
    "Campanias": [ "PS_EC_VIDA_BCP", "PS_EC_VIDA_DIRECTO", "PS_EC_VIDA_LEY", "PS_EC_STR" ]
  },
  "Keycloak": {
    "Authority": "https://auth.grupogss.com.pe/realms/covisian",
    "Audience": "covisian-client-api",
    "ClientId": "covisian-client-api",
    "ClientSecret": "",
    "TokenUrl": "https://ext-auth.grupogss.com.pe:9445/realms/covisian/protocol/openid-connect/token",
    "CertsUrl": "https://auth.grupogss.com.pe:9445/realms/covisian/.well-known/openid-configuration",
    "Scopes": {
      "openid": "OpenID Connect scope",
      "profile": "Profile scope",
      "email": "Email scope"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": "Warning",
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "",
          "tableName": "GSS_LogPacifico",
          "autoCreateSqlTable": true,
          "batchPostingLimit": 50,
          "period": "00:00:10",
          "columnOptionsSection": {
            "addStandardColumns": [ "LogEvent" ],
            "removeStandardColumns": [ "Properties" ],
            "additionalColumns": [
              {
                "ColumnName": "MachineName",
                "DataType": "nvarchar",
                "DataLength": 50
              },
              {
                "ColumnName": "Application",
                "DataType": "nvarchar",
                "DataLength": 100
              },
              {
                "ColumnName": "Celular",
                "DataType": "nvarchar",
                "DataLength": 80
              },
              {
                "ColumnName": "ContactId",
                "DataType": "nvarchar",
                "DataLength": 100
              }
            ]
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentUserName" ]
  }
}